# --- OCI CONFIGURATION & COHERE ---
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxx
OCI_BUCKET_NAME=nexushcm-documents
OCI_NAMESPACE=tu-namespace-oci
OCI_CONFIG_PROFILE=DEFAULT

# Endpoints/Modelos de OCI Generative AI
# (Cohere Command R o Command R+ son excelentes opciones para RAG)
OCI_GENAI_ENDPOINT=https://oraclecloud.com
OCI_LLM_MODEL_ID=cohere.command-r-plus
OCI_EMBEDDING_MODEL_ID=cohere.embed-english-v3.0

# --- FALLBACK CONFIGURATION ---
# Indica qué proveedor usar si el principal falla (ej: "oci" u "openai")
LLM_PROVIDER_ACTIVE=oci
LLM_PROVIDER_FALLBACK=openai

# Credenciales del modelo de respaldo
OPENAI_API_KEY=sk-proj-tu-api-key-de-respaldo-aqui
OPENAI_MODEL_NAME=gpt-4o-mini
